{
  "$description": "OHarness design tokens. DTCG format (https://www.designtokens.org): $type, $value, $description, groups. Themes are carried in $extensions.oh.themes because DTCG has no theme object: $value is the default Graphite (dark) theme, themes.light is Ivory. $extensions.oh.css names the CSS custom property in frontend/src/app/globals.css that must equal the value (checked by npm test); status is code (mirrors the app today), hardcoded (value lives in a component, no variable yet), tailwind (comes from the Tailwind scale) or proposed (new, not yet in the app; none today).",
  "color": {
    "$type": "color",
    "$description": "Warm graphite is the default theme; warm ivory is the light theme. Chroma means state, never mood: one signal hue, amber for attention, red for fault. If a colour carries no information it is grey. Every colour here is declared in globals.css and checked by npm test.",
    "sub-000": {
      "$type": "color",
      "$value": "oklch(0.170 0.006 72)",
      "$description": "App substrate: window, page and canvas background. Text on it uses ink-primary, ink-dim, ink-mute.",
      "$extensions": {
        "oh": {
          "status": "code",
          "css": "--sub-000",
          "themes": {
            "light": "oklch(0.965 0.008 82)"
          }
        }
      }
    },
    "sub-100": {
      "$type": "color",
      "$value": "oklch(0.205 0.007 72)",
      "$description": "Raised surface: panels, composer, floating sheets, inputs.",
      "$extensions": {
        "oh": {
          "status": "code",
          "css": "--sub-100",
          "themes": {
            "light": "oklch(0.985 0.005 82)"
          }
        }
      }
    },
    "sub-200": {
      "$type": "color",
      "$value": "oklch(0.245 0.008 72)",
      "$description": "Contained surface: inset fields, secondary buttons, user messages, hover on list rows.",
      "$extensions": {
        "oh": {
          "status": "code",
          "css": "--sub-200",
          "themes": {
            "light": "oklch(0.940 0.009 82)"
          }
        }
      }
    },
    "sub-300": {
      "$type": "color",
      "$value": "oklch(0.295 0.009 72)",
      "$description": "Pressed state and strong hover of contained surfaces; node handles. Body text on it needs ink-dim or brighter.",
      "$extensions": {
        "oh": {
          "status": "code",
          "css": "--sub-300",
          "themes": {
            "light": "oklch(0.905 0.010 82)"
          }
        }
      }
    },
    "sub-400": {
      "$type": "color",
      "$value": "oklch(0.355 0.010 72)",
      "$description": "Scrollbar thumbs and the highest elevation step. Never a text ground.",
      "$extensions": {
        "oh": {
          "status": "code",
          "css": "--sub-400",
          "themes": {
            "light": "oklch(0.865 0.011 82)"
          }
        }
      }
    },
    "line": {
      "$type": "color",
      "$value": "oklch(0.350 0.010 72)",
      "$description": "Hairline around panels and floats. Decorative separation only: about 1.6:1, so it never marks a control edge on its own.",
      "$extensions": {
        "oh": {
          "status": "code",
          "css": "--line",
          "themes": {
            "light": "oklch(0.810 0.011 82)"
          }
        }
      }
    },
    "line-soft": {
      "$type": "color",
      "$value": "oklch(0.275 0.008 72)",
