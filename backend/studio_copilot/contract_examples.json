{
  "version": 1,
  "_doc": "Shared golden cases for validateOps (backend/studio_copilot/ops.py AND frontend/src/lib/copilot/ops.ts). Ops run sequentially on a working copy of baseGraph; validation stops at the first failing op (index = that op). ok cases assert resulting node/edge counts. See docs/superpowers/specs/2026-10-04-studio-copilot-design.md section 4.",
  "baseGraph": {
    "nodes": [
      {
        "id": "a1",
        "type": "agent",
        "label": "Writer",
        "config": {
          "roleId": "writer",
          "systemPrompt": "You draft the document."
        }
      },
      {
        "id": "g1",
        "type": "gate",
        "label": "Review Gate",
        "config": {
          "checklist": "- Facts checked"
        }
      },
      {
        "id": "h1",
        "type": "hitl",
        "label": "Approve",
        "config": {
          "approvalLabel": "Approve"
        }
      },
      {
        "id": "s1",
        "type": "skill",
        "label": "tdd",
        "config": {
          "skillId": "tdd"
        }
      }
    ],
    "edges": [
      {
        "source": "a1",
        "sourceHandle": "out",
        "target": "g1",
        "targetHandle": "in"
      },
      {
        "source": "g1",
        "sourceHandle": "pass",
        "target": "h1",
        "targetHandle": "in"
      }
    ]
  },
  "cases": [
    {
      "name": "add_and_wire",
      "ops": [
        {
          "op": "addNode",
          "ref": "n1",
          "type": "agent",
          "label": "Reviewer",
          "config": {
            "roleId": "reviewer",
            "systemPrompt": "You review drafts.",
            "emits": [
              "Reviewed"
            ]
          },
          "near": "g1"
        },
        {
          "op": "connect",
          "from": "g1",
          "fromPort": "fail",
          "to": "n1"
        },
        {
          "op": "connect",
          "from": "n1",
          "to": "g1",
          "toPort": "in"
        }
      ],
      "expect": {
        "ok": true,
        "nodes": 5,
        "edges": 4
      }
    },
    {
      "name": "update_existing",
      "ops": [
        {
          "op": "updateNode",
          "id": "g1",
          "config": {
            "checklist": "- Facts checked\n- Sources cited"
          }
        }
      ],
      "expect": {
        "ok": true,
        "nodes": 4,
        "edges": 2
      }
    },
    {
      "name": "update_new_ref",
      "ops": [
        {
          "op": "addNode",
          "ref": "n1",
          "type": "hitl",
          "label": "Sign-off"
        },
        {
          "op": "updateNode",
          "id": "n1",
          "config": {
            "approvalLabel": "Ship it"
          }
        }
      ],
      "expect": {
        "ok": true,
        "nodes": 5,
        "edges": 2
      }
    },
    {
      "name": "remove_with_edges",
      "ops": [
        {
          "op": "removeNode",
          "id": "h1"
        }
      ],
      "expect": {
        "ok": true,
        "nodes": 3,
        "edges": 1
      }
    },
    {
      "name": "skill_into_agent",
      "ops": [
        {
          "op": "connect",
          "from": "s1",
          "to": "a1"
        }
