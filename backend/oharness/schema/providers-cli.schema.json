{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oharness.dev/schema/providers-cli.schema.json",
  "title": "OHarness providers CLI output",
  "description": "The document `oharness providers list --json`, `test <id> --json`, `doctor --json` and `dump-config --json` print. `schemaVersion` changes only when a field is removed or changes meaning; new optional fields do not bump it. No document ever carries a secret, a secret reference, an account e-mail or raw CLI output.",
  "oneOf": [
    { "$ref": "#/$defs/list" },
    { "$ref": "#/$defs/test" },
    { "$ref": "#/$defs/doctor" },
    { "$ref": "#/$defs/dumpConfig" }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "required": ["value", "origin"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "boolean", "null"] },
        "origin": { "enum": ["default", "app", "env"], "description": "default: built in (the catalog, the platform); app: a connection the app stored; env: this process's environment. Never the environment of a CLI subprocess." }
      }
    },
    "dumpConfig": {
      "type": "object",
      "required": ["schemaVersion", "command", "environment", "connections"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "dump-config" },
        "environment": {
          "type": "object",
          "required": ["dataDir", "secretsBackend", "secretsDir", "database"],
          "additionalProperties": false,
          "properties": {
            "dataDir": { "$ref": "#/$defs/field" },
            "secretsBackend": { "$ref": "#/$defs/field" },
            "secretsDir": {
              "type": "object",
              "required": ["value", "origin"],
              "additionalProperties": false,
              "properties": {
                "value": { "enum": ["default", "custom", null], "description": "default: the app's own `<data>/secrets`; custom: another folder; null: the backend is not a file." },
                "origin": { "enum": ["default", "app", "env"] }
              }
            },
            "database": { "$ref": "#/$defs/field" }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "provider", "fields"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "fields": {
                "type": "object",
                "required": ["label", "residence", "enabled", "endpoint", "defaultModel", "credentialKind", "secretStored"],
                "additionalProperties": false,
                "properties": {
                  "label": { "$ref": "#/$defs/field" },
                  "residence": { "$ref": "#/$defs/field" },
                  "enabled": { "$ref": "#/$defs/field" },
                  "endpoint": { "$ref": "#/$defs/field" },
                  "defaultModel": { "$ref": "#/$defs/field" },
                  "credentialKind": { "$ref": "#/$defs/field" },
                  "secretStored": { "$ref": "#/$defs/field" }
                }
              }
            }
          }
        }
      }
    },
    "doctor": {
      "type": "object",
      "required": ["schemaVersion", "command", "app", "connections"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "doctor" },
        "app": {
          "type": "object",
          "required": ["version", "os"],
          "additionalProperties": false,
          "properties": { "version": { "type": "string" }, "os": { "type": "string" } }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "provider", "label", "enabled", "credentialKind", "credentialOrigin", "state", "failureClass", "endpoint", "cli"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "label": { "type": "string" },
              "enabled": { "type": "boolean" },
              "credentialKind": { "enum": ["cli", "api-key", "none"] },
              "credentialOrigin": { "enum": ["cli", "vault", "none"] },
              "state": { "enum": ["ready", "not-logged-in", "not-installed", "unavailable", "error", "configured", "no-credential", "disabled"] },
              "failureClass": { "enum": ["cli-signin", "cli-missing", "cli-unavailable", "cli-error", "credential-missing", null] },
              "endpoint": { "type": "string", "description": "Scheme, host, port and path only; empty when there is none." },
              "cli": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["id", "version", "path"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string" },
                      "version": { "type": ["string", "null"] },
                      "path": { "type": ["string", "null"], "description": "The user's home directory is spelled `~`." }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "list": {
      "type": "object",
      "required": ["schemaVersion", "command", "dataDir", "connections"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "list" },
        "dataDir": { "type": "string", "description": "Relative to the profile (`~/...`) when it lives there; the full path with `--verbose`." },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "provider", "label", "residence", "endpoint", "enabled", "credentialKind", "hasSecret", "defaultModel"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "label": { "type": "string" },
              "residence": { "enum": ["local", "cloud"] },
              "endpoint": { "type": "string", "description": "Scheme, host, port and path only: never userinfo, query or fragment; empty when it is not an http(s) URL." },
              "enabled": { "type": "boolean" },
              "credentialKind": { "enum": ["cli", "api-key", "none", "unknown"] },
              "hasSecret": { "type": "boolean" },
              "defaultModel": { "type": "string" }
            }
          }
        }
      }
    },
    "test": {
      "type": "object",
      "required": ["schemaVersion", "command", "id", "provider", "ok", "health", "message", "latencyMs", "modelCount"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "test" },
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "ok": { "type": "boolean" },
        "health": { "enum": ["live", "setup", "degraded", "fault"] },
        "message": { "type": "string", "description": "One fixed sentence per state (en or pt-BR). Never a probe's own text." },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "modelCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
