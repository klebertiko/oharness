{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oharness.dev/schema/automation.schema.json",
  "title": "OHarness factory automation (frontmatter of automations/<id>/automation.md)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "event"
        ],
        "properties": {
          "provider": {
            "enum": [
              "github",
              "webhook",
              "schedule"
            ]
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "filter": {
            "type": "object"
          },
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "cron"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "cron": {
                "type": "string",
                "maxLength": 100
              },
              "timezone": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokensPerRun": {
          "type": "integer",
          "minimum": 1
        },
        "tokensPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "maxOpen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    }
  },
  "required": [
    "triggers"
  ]
}