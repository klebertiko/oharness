{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oharness.dev/schema/webhook.schema.json",
  "title": "OHarness Forja webhook (webhooks/<id>.yaml); secrets are references only",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "authMode": {
      "enum": [
        "token",
        "signature"
      ]
    },
    "signatureScheme": {
      "enum": [
        "github",
        "generic",
        "standard"
      ]
    },
    "secretRef": {
      "type": "string",
      "pattern": "^forja/[A-Za-z0-9_.-]{1,100}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "deliveryIdHeader": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,100}$"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handle": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedAuthors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selfLogins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "secretRef"
  ]
}