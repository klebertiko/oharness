{
  "$id": "https://oharness.dev/schema/forja-definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "additionalProperties": false,
      "maxProperties": 50,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "engine": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            "harness": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            "instructions": {
              "maxLength": 20000,
              "minLength": 0,
              "type": "string"
            },
            "localSkills": {
              "additionalProperties": false,
              "maxProperties": 50,
              "patternProperties": {
                "^[a-z0-9][a-z0-9-]{0,62}$": {
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "maxLength": 20000,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            },
            "mcp": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "maxItems": 50,
              "type": "array",
              "uniqueItems": true
            },
            "memory": {
              "additionalProperties": false,
              "properties": {
                "maxNoteChars": {
                  "maximum": 400,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxNotes": {
                  "maximum": 50,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxTotalBytes": {
                  "maximum": 20480,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "maxNotes",
                "maxNoteChars",
                "maxTotalBytes"
              ],
              "type": "object"
            },
            "model": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,99}$",
              "type": "string"
            },
            "networkPolicy": {
              "additionalProperties": false,
              "properties": {
                "allowedHosts": {
                  "items": {
                    "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+|(?:\\d{1,3}\\.){3}\\d{1,3})$",
                    "type": "string"
                  },
                  "maxItems": 50,
                  "type": "array",
                  "uniqueItems": true
                },
                "deniedHosts": {
                  "items": {
                    "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+|(?:\\d{1,3}\\.){3}\\d{1,3})$",
                    "type": "string"
                  },
                  "maxItems": 50,
                  "type": "array",
                  "uniqueItems": true
                },
                "extends": {
                  "items": {
                    "pattern": "^[a-z0-9][a-z0-9./@^-]{0,80}$",
                    "type": "string"
                  },
                  "maxItems": 10,
                  "type": "array",
                  "uniqueItems": true
                }
              },
              "type": "object"
            },
            "permissions": {
              "additionalProperties": false,
              "properties": {
                "maxTokens": {
                  "maximum": 1000000000,
                  "minimum": 1,
                  "type": "integer"
                },
                "mode": {
                  "enum": [
                    "plan",
                    "read_only",
                    "ask",
                    "auto_workspace",
                    "workspace_write",
                    "full"
                  ]
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            },
            "role": {
              "enum": [
                "foreman",
                "triage",
                "spec",
                "implement",
                "review",
                "verify",
                "monitor",
                "custom"
              ]
            },
            "runner": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            "secrets": {
              "items": {
                "pattern": "^forja/[A-Za-z0-9_.-]{1,100}$",
                "type": "string"
              },
              "maxItems": 50,
              "type": "array",
              "uniqueItems": true
            },
            "skills": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "maxItems": 50,
              "type": "array",
              "uniqueItems": true
            },
            "tokenCeiling": {
              "maximum": 1000000000,
              "minimum": 1,
              "type": "integer"
            },
            "trigger": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            }
          },
          "required": [
            "role",
            "model",
            "instructions",
            "skills",
            "localSkills",
            "mcp",
            "permissions",
            "secrets",
            "memory",
            "enabled"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "alias": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "benchmarks": {
      "additionalProperties": false,
      "maxProperties": 50,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            "repeats": {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            "successCriteria": {
              "maxLength": 4000,
              "minLength": 0,
              "type": "string"
            },
            "task": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "task"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "blueprint": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "to": {
                "enum": [
                  "intake",
                  "triage",
                  "spec",
                  "implement",
                  "review",
                  "verify",
                  "handoff",
                  "monitor",
                  "end"
                ]
              },
              "when": {
                "maxLength": 500,
                "minLength": 0,
                "type": "string"
              }
            },
            "required": [
              "to"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        },
        "gates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "prompt": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "stage": {
                "enum": [
                  "intake",
                  "triage",
                  "spec",
                  "implement",
                  "review",
                  "verify",
                  "handoff",
                  "monitor"
                ]
              },
              "when": {
                "maxLength": 500,
                "minLength": 0,
                "type": "string"
              }
            },
            "required": [
              "id",
              "stage",
              "prompt"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        },
        "routes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "enum": [
                  "intake",
                  "triage",
                  "spec",
                  "implement",
                  "review",
                  "verify",
                  "handoff",
                  "monitor"
                ]
              },
              "maxReturns": {
                "maximum": 10,
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "maxLength": 500,
                "minLength": 0,
                "type": "string"
              },
              "to": {
                "enum": [
                  "intake",
                  "triage",
                  "spec",
                  "implement",
                  "review",
                  "verify",
                  "handoff",
                  "monitor",
                  "end"
                ]
              },
              "when": {
                "maxLength": 500,
                "minLength": 0,
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "maxItems": 40,
          "type": "array"
        }
      },
      "type": "object"
    },
    "ceilings": {
      "additionalProperties": false,
      "properties": {
        "tokensPerRun": {
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        },
        "tokensPerWorkItem": {
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "harness": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "model": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,99}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "kind": {
      "const": "forja"
    },
    "mcp": {
      "additionalProperties": false,
      "maxProperties": 50,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "maxLength": 500,
                    "minLength": 0,
                    "type": "string"
                  },
                  "maxItems": 50,
                  "type": "array"
                },
                "command": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "env": {
                  "additionalProperties": false,
                  "maxProperties": 50,
                  "patternProperties": {
                    "^[A-Z_][A-Z0-9_]{0,63}$": {
                      "pattern": "^forja/[A-Za-z0-9_.-]{1,100}$",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "command"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "headers": {
                  "additionalProperties": false,
                  "maxProperties": 50,
                  "patternProperties": {
                    "^[A-Za-z0-9-]{1,100}$": {
                      "pattern": "^forja/[A-Za-z0-9_.-]{1,100}$",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "url": {
                  "pattern": "^https?://[^\\s]{1,2000}$",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            }
          ]
        }
      },
      "type": "object"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowedHosts": {
          "items": {
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+|(?:\\d{1,3}\\.){3}\\d{1,3})$",
            "type": "string"
          },
          "maxItems": 50,
          "type": "array",
          "uniqueItems": true
        },
        "deniedHosts": {
          "items": {
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+|(?:\\d{1,3}\\.){3}\\d{1,3})$",
            "type": "string"
          },
          "maxItems": 50,
          "type": "array",
          "uniqueItems": true
        },
        "extends": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9./@^-]{0,80}$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "maxPermissionMode": {
          "enum": [
            "plan",
            "read_only",
            "ask",
            "auto_workspace",
            "workspace_write",
            "full"
          ]
        },
        "maxReviewReturns": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "requireSpec": {
          "type": "boolean"
        },
        "reviewIndependence": {
          "enum": [
            "require",
            "warn",
            "off"
          ]
        },
        "specApproval": {
          "enum": [
            "required",
            "optional"
          ]
        }
      },
      "required": [
        "requireSpec",
        "specApproval",
        "maxReviewReturns",
        "reviewIndependence",
        "maxPermissionMode"
      ],
      "type": "object"
    },
    "repositories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "path": {
            "pattern": "^(\\.|[A-Za-z0-9_][A-Za-z0-9_.@+-]*(/[A-Za-z0-9_][A-Za-z0-9_.@+-]*)*)$",
            "type": "string"
          },
          "protectedBranches": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/*-]{0,199}$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "subdir": {
            "pattern": "^(\\.|[A-Za-z0-9_][A-Za-z0-9_.@+-]*(/[A-Za-z0-9_][A-Za-z0-9_.@+-]*)*)$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "protectedBranches"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "reserved": {
      "additionalProperties": false,
      "properties": {
        "automations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "webhooks": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "runners": {
      "additionalProperties": false,
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "additionalProperties": false,
          "properties": {
            "credentialStrategy": {
              "enum": [
                "forja",
                "user"
              ]
            },
            "maxConcurrentRuns": {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            "pushSecretRef": {
              "pattern": "^forja/[A-Za-z0-9_.-]{1,100}$",
              "type": "string"
            },
            "setup": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "items": {
                      "maxLength": 500,
                      "minLength": 1,
                      "type": "string"
                    },
                    "maxItems": 20,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "argv"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "type": "array"
            },
            "type": {
              "enum": [
                "local"
              ]
            }
          },
          "required": [
            "type",
            "maxConcurrentRuns",
            "credentialStrategy"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "scorers": {
      "additionalProperties": false,
      "maxProperties": 50,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "additionalProperties": false,
          "properties": {
            "agents": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "maxItems": 20,
              "type": "array",
              "uniqueItems": true
            },
            "check": {
              "enum": [
                "ci_failed",
                "qa_rejected",
                "sec_found",
                "gate_changes",
                "pr_closed_unmerged",
                "returns_over_cap",
                "human_intervention",
                "cost_over_envelope"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "classification",
                "deterministic"
              ]
            },
            "labels": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "maxLength": 400,
                    "minLength": 0,
                    "type": "string"
                  },
                  "score": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "value": {
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                    "type": "string"
                  }
                },
                "required": [
                  "value",
                  "score"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "type": "array"
            },
            "model": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,99}$",
              "type": "string"
            },
            "passingScore": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "rubric": {
              "maxLength": 20000,
              "minLength": 0,
              "type": "string"
            },
            "samplingRate": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "selfImprovement": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "passingScore"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "selfImprovement": {
      "additionalProperties": false,
      "properties": {
        "ageDays": {
          "maximum": 90,
          "minimum": 1,
          "type": "integer"
        },
        "analyst": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "canaryPercent": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "failureThreshold": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "minSampleRuns": {
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "sampleDays": {
          "maximum": 90,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "skills": {
      "additionalProperties": false,
      "maxProperties": 100,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "stages": {
      "additionalProperties": false,
      "properties": {
        "implement": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "monitor": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "review": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "spec": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "triage": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "verify": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "tiers": {
      "additionalProperties": false,
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "additionalProperties": false,
          "properties": {
            "models": {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,99}$",
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "models"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "name",
    "alias",
    "defaults",
    "repositories",
    "tiers",
    "ceilings",
    "policy",
    "stages",
    "runners",
    "agents",
    "skills",
    "mcp",
    "reserved"
  ],
  "title": "Forja definition (the merged form of .oharness/forja)",
  "type": "object"
}
