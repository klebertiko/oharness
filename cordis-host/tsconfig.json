{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@oharness/dsh-directory-picker": ["./vendor/dsh/directory-picker/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "proofs/**/*.ts"]
}
