{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!out",
      "!coverage",
      "!next-env.d.ts",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "next": "recommended"
    },
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false
          }
        },
        "noRestrictedElements": {
          "level": "info",
          "options": {
            "elements": {
              "button": "Use Button or IconButton from components/ui.",
              "input": "Use Input, Checkbox or Select from components/ui.",
              "select": "Use Select from components/ui.",
              "textarea": "Use Textarea from components/ui."
            }
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "off",
        "noCommonJs": "error",
        "noNamespace": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noUselessEscapeInString": "off",
        "noUnusedExpressions": "error",
        "noTsIgnore": "error"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useOptionalChain": "off",
        "useArrowFunction": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noAutofocus": "off",
        "noNoninteractiveElementToInteractiveRole": "off"
      },
      "performance": {
        "noSyncScripts": "error"
      }
    }
  },
  "plugins": [
    "./lint/no-unescaped-entities.grit",
    "./lint/no-anonymous-default-export.grit"
  ],
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": "off"
          }
        }
      }
    }
  ]
}
