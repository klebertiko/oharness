# OHM em YAML 1.2 — contrato declarativo.
schemaVersion: "1.0.0"
manifest:
  id: hello
  name: Hello
  version: "0.1.0"
  description: Documento mínimo do OHarness Model.
  license: MIT
  tags: []
graph:
  nodes: []
  edges: []
content:
  prompts:
    objetivo: |-
      Descreva o objetivo do trabalho.
      Defina as evidências para aceitar o resultado.
  agents: {}
  skills: {}
  hooks: {}
  commands: {}
  scripts: {}
runtime:
  preferred: api
  cli: null
  env: []
  secrets: []
validation:
  mockProfile: default
