# Root / Tauri CLI
node_modules/
src-tauri/target/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/out/
frontend/tsconfig.tsbuildinfo

# Backend
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/data/
backend/.env
backend/.pytest_cache/
backend/.venv/
backend/venv/

# SDD / tooling
.superpowers/
.worktrees/
.tools/

# Docker / OS
*.log
.DS_Store
Thumbs.db

# Backend build/test cache artifacts (regenerable, not source)
backend/build/
backend/.mutmut-cache

# Local agent/tooling state (machine-specific, never source)
.claude/*
!.claude/settings.json
!.claude/hooks/
.pytest_cache/
__pycache__/

# Gauntlet scratch workspace: CI failure logs, raw scanner SARIF,
# ad-hoc GitHub API scripts and third-party reference screenshots.
# Durable gauntlet write-ups live in docs/product/gauntlet-automate/.
.gauntlet/

# Local capture/build output (site screenshots, reports)
/artifacts/
