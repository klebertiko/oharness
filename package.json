{
  "name": "oharness-desktop",
  "version": "0.0.1-alpha",
  "private": true,
  "description": "OHarness Tauri shell — run from repo root",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "brand:icons": "node scripts/brand-icons.mjs",
    "frontend:build": "npm run build --prefix frontend",
    "sidecar:dev": "cd backend && python -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "desktop:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
